# ---------------------------------------------------------------------------
# Slot A — Retrieval + Evaluation Harness
# Everything derived (indexes, runs, scores, reports) and everything vendored
# (reference repos) stays out of git. Only source + notes are tracked.
# ---------------------------------------------------------------------------

# Derived artifacts — raw data cache stays ignored; index and runs are tracked
artifacts/data/

# Study-only reference repos (cloned, never run to completion, numbers never trusted)
reference/


# Model / dataset caches
.cache/
**/.cache/
huggingface/
hf_cache/
transformers_cache/
sentence_transformers_cache/
torch_cache/
datasets_cache/
flagembedding_cache/

# Serialized index + model blobs
*.index
*.faiss
*.pkl
*.pickle
!artifacts/index/*
*.npy
*.npz
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.onnx

# BEIR / SciFact raw downloads
data/
datasets/
*.zip
*.tar.gz

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Notebooks
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets / env
.env
.env.*
!.env.example
.claude

# OS
.DS_Store
Thumbs.db
